# Convex Backend
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Zero-Cost Local Testing Flags
LOCAL_BROWSER=true
OPENROUTER_DEV_FREE=true
HEADLESS=false
LOCAL_NOVNC_URL=http://localhost:6080

# OpenRouter AI Routing ($15/mo sub-key cap in prod; :free models when OPENROUTER_DEV_FREE=true)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_CLIENT_SUBKEY=sk-or-v1-client-subkey
# OPENROUTER_FREE_FAST_MODEL=openrouter/free
# OPENROUTER_FREE_AUDIT_MODEL=nvidia/nemotron-3.5-lightning:free

# Boat.dev Sandbox VMs (bypassed when LOCAL_BROWSER=true)
BOAT_API_KEY=boat_your_api_key_here
# BOAT_BASE_URL=https://boat.dev/api/v1

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=mundus-tender-ops-verify
# WHATSAPP_APP_SECRET=your-meta-app-secret
